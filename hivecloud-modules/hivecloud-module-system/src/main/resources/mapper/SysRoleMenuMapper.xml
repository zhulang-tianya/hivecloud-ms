<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hivecloud.system.mapper.SysRoleMenuMapper">

    <resultMap id="SysRoleMenuResult" type="com.hivecloud.system.entity.SysRoleMenu">
        <id property="id" column="id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="roleId" column="role_id"/>
        <result property="menuId" column="menu_id"/>
    </resultMap>

    <select id="selectMenuIdsByRoleId" resultType="java.lang.Long">
        SELECT menu_id
        FROM sys_role_menu
        WHERE role_id = #{roleId}
    </select>

    <select id="selectMenuIdsByUserId" resultType="java.lang.Long">
        SELECT DISTINCT rm.menu_id
        FROM sys_role_menu rm
        INNER JOIN sys_user_role ur ON rm.role_id = ur.role_id
        WHERE ur.user_id = #{userId}
    </select>

    <delete id="deleteByRoleId">
        DELETE FROM sys_role_menu
        WHERE role_id = #{roleId}
    </delete>

    <insert id="batchSave">
        INSERT INTO sys_role_menu (tenant_id, role_id, menu_id)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.tenantId}, #{item.roleId}, #{item.menuId})
        </foreach>
    </insert>

</mapper>
